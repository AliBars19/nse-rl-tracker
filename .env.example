# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
#
# Without the two Supabase public values the site still runs, read-only, on the
# bundled Spring 26 snapshot (src/data/seed/spring-26.json).

# Supabase → Project Settings → API. "Publishable" is the new name for the anon key;
# either variable name works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. ballchasing.com → Upload tab → API token.
BALLCHASING_TOKEN=
# Optional: public | unlisted | private (default unlisted)
BALLCHASING_VISIBILITY=unlisted

# Optional extra gate: only this email can use /admin, even if listed in `admins`.
ADMIN_EMAIL=
